{
  "info": {
    "name": "real-time-app",
    "description": "Postman collection with dynamic token handling",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sanctum Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user1@example.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/sanctum/token",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "sanctum", "token"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save token from response JSON into Postman environment",
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set('token', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Ad Slots (Open)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/ad-slots?status=open",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "ad-slots"],
          "query": [
            {
              "key": "status",
              "value": "open"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Place Bid on Ad Slot",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 25.00\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/ad-slots/1/bid",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "ad-slots", "1", "bid"]
        }
      },
      "response": []
    },
    {
      "name": "Get Ad Slot Winner",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/ad-slots/1/winner",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "ad-slots", "1", "winner"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}
